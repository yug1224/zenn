    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-rule-preset-ja-technical-writing": "^12.1.0",
    "textlint-rule-prh": "^6.1.1",
    "textlint-rule-zenn-prose": "link:./textlint-rules/zenn-prose"
